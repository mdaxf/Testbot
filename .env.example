# testbot settings. Copy this file to ".env" next to testbot.exe / testbot-manager.exe (or into the folder you start them from)
# and remove the "#" in front of what you need. A real environment variable always wins over a .env entry. Empty values are ignored.
# Nothing here is required to start: every setting below is shown with its default or an example.

# ============================================================ Test mode
# script  = run the recorded steps (default)   agentic = the AI agent works from the objective   auto = script, then agent when no steps
# Overrides the case's and suite's `mode`; the --mode command-line option overrides this.
# TESTBOT_MODE=script

# ============================================================ AI provider keys (never put keys in config files)
# AI_VISION_PROVIDER picks the LLM for the AI locator fallback, the agent (unless TESTBOT_AGENT_PROVIDER is set) and the
# manager's AI assistant: anthropic | openai | azure_openai | gemini. Default: anthropic. Set only the block you use.
AI_VISION_PROVIDER=anthropic
# AI_VISION_MODEL overrides the vision model of the active provider (ignored for azure_openai, which uses AZURE_OPENAI_DEPLOYMENT).
# Defaults: claude-sonnet-5 / gpt-4o / gemini-2.0-flash
# AI_VISION_MODEL=
# AI_TEXT_MODEL overrides the model for the manager's AI assistant and the agent (default: claude-sonnet-5-5 / gpt-4o / gemini-2.0-flash)
# AI_TEXT_MODEL=

# anthropic (default)
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# azure_openai
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-gpt4o-deployment-name
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# gemini
# GEMINI_API_KEY=...

# ============================================================ Agentic tests (natural-language objectives)
# TESTBOT_AGENT_PROVIDER=anthropic       # default: AI_VISION_PROVIDER
# TESTBOT_AGENT_MODEL=                   # default: AI_TEXT_MODEL, then the provider's default
# TESTBOT_AGENT_MAX_STEPS=40             # actions the agent may take in one test
# TESTBOT_AGENT_MAX_TOKENS=400000        # total model tokens (input + output) for one test
# TESTBOT_AGENT_TIMEOUT_S=600            # wall-clock limit for one test, in seconds
# TESTBOT_AGENT_VISION=auto              # off | auto (screenshot at the start, after a failure, or on request) | always
# TESTBOT_AGENT_ALLOW_DESTRUCTIVE=0      # 1 lets the agent press destructive buttons (Delete, Remove ...) without the objective asking for it
# TESTBOT_AGENT_LEARN=0                  # 1 saves what a PASSING agent run found as a recommendation on the test case
# TESTBOT_AGENT_PROFILE=config/app_profile_apriso.yaml   # application profile (YAML) that teaches the agent the app's controls
# TESTBOT_AGENT_ALLOWED_HOSTS=           # comma-separated hosts the agent may visit besides the test's own, e.g. sso.example.com,login.example.com
# TESTBOT_AGENT_HEAL=suggest             # self-healing of scripted steps (default: suggest)

# ============================================================ Database passwords
# Referenced from config/environments.yaml as PWD={env:TESTBOT_DB_...}
# (only variables starting with TESTBOT_DB_ can be used in a connection string).
# TESTBOT_DB_PASSWORD_WIN_APR23=
# TESTBOT_DB_PASSWORD_QA=

# ============================================================ Email notifications (SMTP defaults for every environment)
# The same values can be set on the manager's Settings page; an environment's own `email:` block overrides them.
# TESTBOT_EMAIL_HOST=smtp.example.com
# TESTBOT_EMAIL_PORT=587
# TESTBOT_EMAIL_SECURITY=starttls        # starttls | ssl | none
# TESTBOT_EMAIL_USERNAME=testbot@example.com
# TESTBOT_EMAIL_PASSWORD_ENV=TESTBOT_SMTP_PASSWORD   # the NAME of the variable that holds the password (must start with TESTBOT_SMTP_)
# TESTBOT_EMAIL_FROM=testbot@example.com
# TESTBOT_EMAIL_TO=qa-team@example.com,lead@example.com
# TESTBOT_EMAIL_ON=failure               # never | always | failure
# TESTBOT_EMAIL_ATTACH_REPORT=1          # 1 attaches the HTML report, 0 does not

# SMTP password named by TESTBOT_EMAIL_PASSWORD_ENV or an email block's password_env (must start with TESTBOT_SMTP_).
# TESTBOT_SMTP_PASSWORD=
# TESTBOT_SMTP_PASSWORD_UAT=

# ============================================================ Certificates and proxy (corporate networks)
# For the AI services, the manager's connection test and the agent.
# TESTBOT_SSL_CA_BUNDLE_FILE=C:\certs\corp-root.pem   # extra trusted root certificates (.pem/.crt/.cer); several paths separated by ;
# TESTBOT_SSL_USE_OS_TRUSTSTORE=1                      # 1 also trusts the Windows certificate store (default), 0 does not
# TESTBOT_PROXY=http://proxy.example.com:8080          # default: HTTPS_PROXY from the environment
# Also read as fallbacks: SSL_CERT_FILE, REQUESTS_CA_BUNDLE, AI_CA_BUNDLE, AI_USE_SYSTEM_CERTS, AI_PROXY

# ============================================================ Logging
# TESTBOT_LOG_LEVEL=info                 # debug | info | warning | error  (the --log-level option overrides this)
# TESTBOT_LOG_LEVELS=agent=debug,sql=warning   # per-area levels
# TESTBOT_LOG_CONSOLE=1                  # 0 hides log lines on the console
# TESTBOT_LOG_FILE=logs/testbot.log      # also write a rotating log file (5 MB x 3)

# ============================================================ Manager and screenshots
# TESTBOT_WORKSPACE=C:\testbot\workspace  # folder (or file) of testbot-workspace.json; default: next to the program
# TESTBOT_WATERMARK=on                   # off removes the product watermark from screenshots
